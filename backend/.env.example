DATABASE_URL=postgresql+asyncpg://devflow:devflow@localhost:5432/devflow
# At least 32 characters. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Callback URL registered there must equal GITHUB_REDIRECT_URI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/github/callback
# Encrypts stored GitHub tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Emails (verification, password reset). "console" prints them to the API log
# instead of sending, which is enough for development.
EMAIL_BACKEND=console
EMAIL_FROM=DevFlow <no-reply@devflow.local>
# For EMAIL_BACKEND=smtp, e.g. Gmail (smtp.gmail.com, an app password),
# Resend (smtp.resend.com, user "resend") or SendGrid (smtp.sendgrid.net, user "apikey").
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Login/registration attempt limits. Leave on.
RATE_LIMIT_ENABLED=true
